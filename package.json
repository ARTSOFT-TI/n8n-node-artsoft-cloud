{
	"name": "n8n-nodes-artsoft-cloud",
	"version": "2.0.0",
	"description": "n8n community node for ARTSOFT Cloud Invoice integration",
	"license": "MIT",
	"homepage": "https://github.com/ARTSOFT-TI/n8n-node-artsoft-cloud#readme",
	"keywords": [
		"n8n-community-node-package",
		"artsoft"
	],
	"author": {
		"name": "ARTSOFT Business Software",
		"email": "programacao@artsoft.pt"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ARTSOFT-TI/n8n-node-artsoft-cloud.git"
	},
	"bugs": {
		"url": "https://github.com/ARTSOFT-TI/n8n-node-artsoft-cloud/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest --runInBand",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ArtsoftCloudApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ArtsoftCloud/ArtsoftCloud.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/jest": "^30.0.0",
		"@types/node": "^18.16.0",
		"dotenv": "^17.3.1",
		"eslint": "9.32.0",
		"jest": "^30.3.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"ts-jest": "^29.4.6",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
